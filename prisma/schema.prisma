generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Session {
  id                  String    @id
  userId              BigInt
  title               String?
  studyLanguage       String    @default("en")
  translationLanguage String    @default("ru")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  endedAt             DateTime?

  entries Entry[]

  @@index([userId, endedAt])
}

model UserSettings {
  userId              BigInt   @id
  studyLanguage       String   @default("en")
  translationLanguage String   @default("ru")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model LanguageLevel {
  userId   BigInt
  language String
  level    String @default("B2")

  @@id([userId, language])
}

model Entry {
  id             String      @id
  sessionId      String
  text           String
  normalizedText String
  status         EntryStatus
  usage          EntryUsage?
  translation    String?
  errorMessage   String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  session  Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  examples EntryExample[]

  @@unique([sessionId, normalizedText])
  @@index([sessionId])
  @@index([sessionId, status])
}

model EntryExample {
  id          String @id
  entryId     String
  text        String
  translation String
  sortOrder   Int

  entry Entry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([entryId, sortOrder])
  @@index([entryId])
}

model EnrichmentCache {
  id             String      @id
  normalizedText String
  sourceText     String
  model          String
  promptVersion  String
  studyLanguage  String      @default("en")
  level          String      @default("B2")
  usage          EntryUsage?
  translation    String
  examplesJson   Json
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([normalizedText, model, promptVersion, studyLanguage, level])
  @@index([normalizedText])
}

enum EntryStatus {
  pending
  completed
  failed
}

enum EntryUsage {
  A
  B
  C
}
