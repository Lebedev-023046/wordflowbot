POSTGRES_DB=wordflowbot
POSTGRES_ADMIN_USER=wordflowbot_admin
POSTGRES_ADMIN_PASSWORD=replace_with_a_strong_random_admin_password
APP_DB_USER=wordflowbot_app
APP_DB_PASSWORD=replace_with_a_strong_random_app_password
MIGRATION_DB_USER=wordflowbot_migrator
MIGRATION_DB_PASSWORD=replace_with_a_strong_random_migration_password

DATABASE_URL=postgresql://wordflowbot_app:replace_with_a_strong_random_app_password@localhost:5433/wordflowbot?schema=public
MIGRATION_DATABASE_URL=postgresql://wordflowbot_migrator:replace_with_a_strong_random_migration_password@localhost:5433/wordflowbot?schema=public

BOT_TOKEN=1234567890:replace_with_your_real_telegram_bot_token
OPENAI_API_KEY=sk-replace_with_your_real_openai_api_key
OPENAI_MODEL=gpt-5.4-mini
OPENAI_SERVICE_TIER=flex

ENRICHMENT_CACHE_FILE=.data/enrichment-cache.json

DEBUG_BOT=false
LOG_USAGE=false
LOG_CACHE=false
